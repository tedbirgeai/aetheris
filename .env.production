# ============================================================
#  AETHERIS / tedbirge Gateway — ÜRETİM ORTAM DEĞİŞKENLERİ (P0)
#  Kopya: cp .env.production .env  → değerleri doldur → kaynağını yükle.
#  git bash:  set -a; source .env; set +a; bash scripts/start-gateway.sh "$AETHERIS_ADMIN_TOKEN"
# ============================================================

# --- Kimlik / erişim ---
AETHERIS_ADMIN_TOKEN=DEGISTIR_guclu_bir_token
# Kiracı API anahtarları. GÜVENLİ biçim: clientID:sha256hex (düz metin YERİNE hash).
# Hash üret:  printf '%s' 'SECRET' | sha256sum | cut -d' ' -f1
AETHERIS_API_KEYS=acme:PUT_SHA256_OF_SECRET_HERE

# --- P0-1: Kalıcı defter (RAM DEĞİL) ---
AETHERIS_STORE=postgres
AETHERIS_DATABASE_DSN=postgres://aetheris:DEGISTIR_parola@127.0.0.1:5432/aetheris?sslmode=disable

# --- P0-3: Kalıcı makbuz imza anahtarı (restart'ta makbuzlar doğrulanabilsin) ---
# Üret:  openssl rand -hex 32
AETHERIS_RECEIPT_SECRET=PUT_64_HEX_HERE

# --- P0-2: Kalıcı voucher issuer seed (restart'ta voucher doğrulaması korunur) ---
# Üret:  openssl rand -hex 32   (boş bırakılırsa wal/voucher_seed.hex'e otomatik yazılır)
AETHERIS_VOUCHER_SEED=PUT_64_HEX_HERE

# --- P0-4: TLS (düz HTTP DEĞİL) ---
AETHERIS_TLS_CERT=certs/cert.pem
AETHERIS_TLS_KEY=certs/key.pem

# --- WAL dayanıklı kuyruk ---
AETHERIS_WAL=true
AETHERIS_WAL_DIR=wal

# --- Mesh / keşif ---
AETHERIS_MESH=true
AETHERIS_MESH_ADDR=:7946
AETHERIS_DISCOVERY=true
AETHERIS_DISCOVERY_PORT=7947
AETHERIS_WAN_CHECK=true

# --- SOCKS5 canlı proxy (telemetri) ---
AETHERIS_SOCKS_ADDR=127.0.0.1:1081

# --- DTN gerçek taşıyıcı (boşsa bundle'lar PENDING kalır — sahte teslim yok) ---
# Örn. merkez toplama ucu; ulaşılabilir olduğunda store-carry-forward teslim eder.
AETHERIS_DTN_UPSTREAM=

# --- QNB Sanal POS (NestPay 3D) — sandbox: vpostest, canlı: vpos ---
AETHERIS_QNBPOS_CLIENTID=
AETHERIS_QNBPOS_STOREKEY=
AETHERIS_QNBPOS_URL=https://vpostest.qnbfinansbank.com/fim/est3Dgate
AETHERIS_QNBPOS_OK_URL=https://SUNUCU/billing/qnb/ok
AETHERIS_QNBPOS_FAIL_URL=https://SUNUCU/billing/qnb/fail

# --- QNB eFinans e-Fatura ---
AETHERIS_EFINANS_URL=
AETHERIS_EFINANS_USER=
AETHERIS_EFINANS_PASS=
AETHERIS_EFINANS_VKN=
AETHERIS_EFINANS_UNVAN=Tedbirge Teknoloji A.Ş.

# --- Prometheus metrik (opsiyonel) ---
AETHERIS_METRICS=true
AETHERIS_METRICS_TOKEN=DEGISTIR_metrik_token
