# AETHERIS Gateway ortam degiskenleri (ORNEK).
# /etc/aetheris/aetheris.env olarak kopyalayin ve degerleri doldurun.
# Sirlari (token, secret, DSN) ASLA depoya commit etmeyin.

AETHERIS_LISTEN=:8080

# Kalicilik
AETHERIS_DATABASE_DSN=postgres://aetheris:CHANGE_ME@127.0.0.1:5432/aetheris?sslmode=disable
AETHERIS_WAL_ENABLED=true
AETHERIS_WAL_DIR=/var/lib/aetheris/wal

# Redis (opsiyonel, tekillestirme/oran limiti)
AETHERIS_REDIS_ADDR=127.0.0.1:6379

# API anahtarlari: "clientID:key" cifti, virgulle ayrilmis
AETHERIS_API_KEYS=acme:CHANGE_ME_LONG_RANDOM

# --- Prometheus metrikleri ---
AETHERIS_METRICS=true
AETHERIS_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# --- Gomulu yonetim paneli (/admin) ---
AETHERIS_ADMIN=true
AETHERIS_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# --- mTLS (opsiyonel; panel ve API'yi istemci sertifikasiyla korur) ---
# AETHERIS_TLS_CERT=/etc/aetheris/tls/server.crt
# AETHERIS_TLS_KEY=/etc/aetheris/tls/server.key
# AETHERIS_TLS_CLIENT_CA=/etc/aetheris/tls/client-ca.crt
# AETHERIS_TLS_CLIENT_AUTH=require
